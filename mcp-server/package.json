{
  "name": "@devdigest/mcp-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local MCP server for DevDigest — exposes review agents, runs, findings, and conventions as MCP tools over stdio.",
  "bin": {
    "devdigest-mcp": "./dist/index.js",
    "devdigest": "./bin/devdigest.mjs"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "review": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
