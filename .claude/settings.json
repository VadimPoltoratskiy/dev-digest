{
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "GITHUB_TOOLSETS": "pull-request,repo",
    "GITHUB_READONLY": "true"
  },
  "permissions": {
    "allow": [
      "Bash(pnpm db:generate)",
      "Bash(pnpm typecheck *)"
    ]
  },
  "enabledPlugins": {
    "github@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pretooluse-commit-gate.mjs\"",
            "timeout": 180,
            "statusMessage": "Running tests before commit…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__devdigest__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/posttooluse-devdigest-mcp.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-engineering-insights.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
